generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Link {
  id           String   @id @default(uuid())
  urlOriginal  String
  urlEncurtada String   @unique
  cliques      Int      @default(0)
  criadoEm     DateTime @default(now())
}